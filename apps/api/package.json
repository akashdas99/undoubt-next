{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"vitest.config.ts\" \"vitest.config.e2e.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint src/",
    "test": "pnpm --filter @workspace/constants build && pnpm --filter @workspace/db build && vitest run",
    "test:watch": "pnpm --filter @workspace/constants build && pnpm --filter @workspace/db build && vitest",
    "test:cov": "pnpm --filter @workspace/constants build && pnpm --filter @workspace/db build && vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm --filter @workspace/constants build && pnpm --filter @workspace/db build && vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@fastify/static": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@workspace/constants": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/validations": "workspace:*",
    "bcryptjs": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "jose": "catalog:",
    "nanoid": "catalog:",
    "sanitize-html": "catalog:",
    "slugify": "catalog:",
    "nestjs-zod": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "resend": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/mau": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/sanitize-html": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
