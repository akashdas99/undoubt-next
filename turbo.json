{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "DATABASE_URI",
        "API_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_BASEURL",
        "COOKIE_DOMAIN"
      ]
    },
    "api#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "PORT",
        "DATABASE_URI",
        "SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "NEXT_PUBLIC_BASEURL",
        "WEB_ORIGIN",
        "COOKIE_DOMAIN"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
